/****** UP-TextArea.mcc/UPA_TextArea_Text ******
*
*   NAME
*       UPA_TextArea_Text -- attribute of UP-TextArea.mcc
*
*   FUNCTION
*       STRPTR: the text. A set copies the string in (cut at the capacity); a get returns the object's own NUL terminated buffer, valid until the next edit. Notifies on every change: notify with MUIV_EveryTime, the pointer stays the same
*
*   INPUTS
*       UPA_TextArea_Text - access ISG. Tag value from <mcc/up.h>.
*
*   RESULT
*       Read with GetAttr/get(), set with SetAttrs/set() or in the MUI_NewObject tag list, as the access letters allow (I = initial, S = set, G = get).
*
*   SEE ALSO
*       <mcc/up.h>, UP-TextArea.mcc
*
******/

/****** UP-TextArea.mcc/UPA_TextArea_MaxLen ******
*
*   NAME
*       UPA_TextArea_MaxLen -- attribute of UP-TextArea.mcc
*
*   FUNCTION
*       LONG: capacity in bytes, default 1024 (a value below 1 gives the default); longer text is cut. Fixed at creation, a get returns the capacity
*
*   INPUTS
*       UPA_TextArea_MaxLen - access IG. Tag value from <mcc/up.h>.
*
*   RESULT
*       Read with GetAttr/get(), set with SetAttrs/set() or in the MUI_NewObject tag list, as the access letters allow (I = initial, S = set, G = get).
*
*   SEE ALSO
*       <mcc/up.h>, UP-TextArea.mcc
*
******/

/****** UP-TextArea.mcc/UPA_TextArea_Placeholder ******
*
*   NAME
*       UPA_TextArea_Placeholder -- attribute of UP-TextArea.mcc
*
*   FUNCTION
*       STRPTR: hint drawn while the text is empty and the object is not active. The string is not copied and must outlive the object
*
*   INPUTS
*       UPA_TextArea_Placeholder - access I. Tag value from <mcc/up.h>.
*
*   RESULT
*       Read with GetAttr/get(), set with SetAttrs/set() or in the MUI_NewObject tag list, as the access letters allow (I = initial, S = set, G = get).
*
*   SEE ALSO
*       <mcc/up.h>, UP-TextArea.mcc
*
******/

/****** UP-TextArea.mcc/UPA_TextArea_Error ******
*
*   NAME
*       UPA_TextArea_Error -- attribute of UP-TextArea.mcc
*
*   FUNCTION
*       BOOL: draw the outline in the ERROR token colour, over the focus ring,
*       to mark the field a validation error names. The next user edit clears
*       it.
*
*   INPUTS
*       UPA_TextArea_Error - access SG. Tag value from <mcc/up.h>.
*
*   RESULT
*       Read with GetAttr/get(), set with SetAttrs/set() or in the MUI_NewObject tag list, as the access letters allow (I = initial, S = set, G = get).
*
*   SEE ALSO
*       <mcc/up.h>, UP-TextArea.mcc
*
******/

/****** UP-TextArea.mcc/UPM_TextArea_Redraw ******
*
*   NAME
*       UPM_TextArea_Redraw -- method of UP-TextArea.mcc
*
*   FUNCTION
*       Method, internal: the window's active object changed, repaint the outline. The class installs the notify on MUIA_Window_ActiveObject itself; callers do not send it
*
*   INPUTS
*       UPM_TextArea_Redraw - method id. Tag value from <mcc/up.h>.
*
*   RESULT
*       Send with DoMethod; see FUNCTION for the return value.
*
*   SEE ALSO
*       <mcc/up.h>, UP-TextArea.mcc
*
******/

/****** UP-Field.mcc/UPA_Field_Key ******
*
*   NAME
*       UPA_Field_Key -- attribute of UP-Field.mcc
*
*   FUNCTION
*       LONG: raw code of the last Up (0x4C), Down (0x4D), Esc (0x45) or Tab (0x42) pressed in the active field; notifies on every press. Up, Down and
*       Shift+Tab then reach the window; Tab cycles to the next object.
*
*   INPUTS
*       UPA_Field_Key - access G. Tag value from <mcc/up.h>.
*
*   RESULT
*       Read with GetAttr/get(), set with SetAttrs/set() or in the MUI_NewObject tag list, as the access letters allow (I = initial, S = set, G = get).
*
*   SEE ALSO
*       <mcc/up.h>, UP-Field.mcc
*
******/

/****** UP-Popstring.mcc/UPA_Popstring_NoActivate ******
*
*   NAME
*       UPA_Popstring_NoActivate -- attribute of UP-Popstring.mcc
*
*   FUNCTION
*       BOOL: the popup window opens inactive, so typing stays in the string (autocomplete); default FALSE.
*
*   INPUTS
*       UPA_Popstring_NoActivate - access I. Tag value from <mcc/up.h>.
*
*   RESULT
*       Read with GetAttr/get(), set with SetAttrs/set() or in the MUI_NewObject tag list, as the access letters allow (I = initial, S = set, G = get).
*
*   SEE ALSO
*       <mcc/up.h>, UP-Popstring.mcc
*
******/

